{
  "name": "vscode-hdl-dev",
  "displayName": "HDL Dev",
  "description": "HDL development support for VS Code",
  "version": "0.0.1",
  "publisher": "cosgroma",
  "preview": true,
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/cosgroma/vscode-hdl-dev.git"
  },
  "bugs": {
    "url": "https://github.com/cosgroma/vscode-hdl-dev/issues"
  },
  "homepage": "https://cosgroma.github.io/vscode-hdl-dev/",
  "keywords": [
    "hdl",
    "vhdl",
    "ghdl",
    "fpga",
    "testbench",
    "waveform"
  ],
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:vscode-hdl-dev.specs",
    "onView:vscode-hdl-dev.artifacts",
    "onCommand:vscode-hdl-dev.openArtifact",
    "onCommand:vscode-hdl-dev.revealArtifact",
    "onCommand:vscode-hdl-dev.copyArtifactPath",
    "onCommand:vscode-hdl-dev.generateWaveformSvg",
    "onCommand:vscode-hdl-dev.generateWaveformSvgNoRun",
    "onCommand:vscode-hdl-dev.generateSchematicSvg",
    "onCommand:vscode-hdl-dev.refreshSpecs",
    "onCommand:vscode-hdl-dev.refreshArtifacts",
    "onCommand:vscode-hdl-dev.checkGhdlDependencies",
    "onCommand:vscode-hdl-dev.checkDocsAssetDependencies"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-hdl-dev.generateWaveformSvg",
        "title": "Generate Waveform SVG",
        "category": "HDL Dev"
      },
      {
        "command": "vscode-hdl-dev.generateWaveformSvgNoRun",
        "title": "Generate Waveform SVG Without Rerun",
        "category": "HDL Dev"
      },
      {
        "command": "vscode-hdl-dev.generateSchematicSvg",
        "title": "Generate Schematic SVG",
        "category": "HDL Dev"
      },
      {
        "command": "vscode-hdl-dev.refreshSpecs",
        "title": "Refresh Specs",
        "category": "HDL Dev"
      },
      {
        "command": "vscode-hdl-dev.refreshArtifacts",
        "title": "Refresh Artifacts",
        "category": "HDL Dev"
      },
      {
        "command": "vscode-hdl-dev.openArtifact",
        "title": "Open Artifact",
        "category": "HDL Dev"
      },
      {
        "command": "vscode-hdl-dev.revealArtifact",
        "title": "Reveal Artifact in File Explorer",
        "category": "HDL Dev"
      },
      {
        "command": "vscode-hdl-dev.copyArtifactPath",
        "title": "Copy Artifact Path",
        "category": "HDL Dev"
      },
      {
        "command": "vscode-hdl-dev.checkGhdlDependencies",
        "title": "Check GHDL Dependencies",
        "category": "HDL Dev"
      },
      {
        "command": "vscode-hdl-dev.checkDocsAssetDependencies",
        "title": "Check Documentation Asset Dependencies",
        "category": "HDL Dev"
      }
    ],
    "configuration": {
      "title": "HDL Dev",
      "properties": {
        "hdlDev.projectRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional explicit HDL project roots. Relative paths resolve under each workspace folder."
        },
        "hdlDev.depsScript": {
          "type": "string",
          "default": "scripts/deps.sh",
          "description": "Path to the dependency script to run from a discovered project or workspace folder."
        },
        "hdlDev.makeExecutable": {
          "type": "string",
          "default": "make",
          "description": "Make executable used for HDL project testbench discovery and runs."
        },
        "hdlDev.defaultStopTime": {
          "type": "string",
          "default": "500us",
          "description": "Default STOP_TIME value passed to Make-backed GHDL testbench runs."
        },
        "hdlDev.defaultWaveFormat": {
          "type": "string",
          "enum": [
            "ghw",
            "fst",
            "vcd"
          ],
          "default": "ghw",
          "description": "Default WAVE_FORMAT value passed to Make-backed GHDL testbench runs."
        },
        "hdlDev.toolchainRoot": {
          "type": "string",
          "default": "",
          "description": "Optional GHDL toolchain root. When set, HDL Dev passes it as GHDL_TOOLCHAIN_ROOT and prepends its bin directory to PATH."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hdlDev",
          "title": "HDL",
          "icon": "media/hdl.svg"
        }
      ]
    },
    "views": {
      "hdlDev": [
        {
          "id": "vscode-hdl-dev.specs",
          "name": "Specs",
          "when": "hdlDev.hasProjects"
        },
        {
          "id": "vscode-hdl-dev.artifacts",
          "name": "Artifacts",
          "when": "hdlDev.hasProjects"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vscode-hdl-dev.refreshSpecs",
          "when": "view == vscode-hdl-dev.specs",
          "group": "navigation"
        },
        {
          "command": "vscode-hdl-dev.refreshArtifacts",
          "when": "view == vscode-hdl-dev.artifacts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vscode-hdl-dev.generateWaveformSvg",
          "when": "view == vscode-hdl-dev.specs && viewItem == hdlDev.specs.spec.waveform.valid",
          "group": "navigation@1"
        },
        {
          "command": "vscode-hdl-dev.generateWaveformSvgNoRun",
          "when": "view == vscode-hdl-dev.specs && viewItem == hdlDev.specs.spec.waveform.valid",
          "group": "navigation@2"
        },
        {
          "command": "vscode-hdl-dev.generateSchematicSvg",
          "when": "view == vscode-hdl-dev.specs && viewItem == hdlDev.specs.spec.schematic.valid",
          "group": "navigation@1"
        },
        {
          "command": "vscode-hdl-dev.openArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.waveDump",
          "group": "navigation@1"
        },
        {
          "command": "vscode-hdl-dev.openArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.waveformSvg",
          "group": "navigation@1"
        },
        {
          "command": "vscode-hdl-dev.openArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.schematicSvg",
          "group": "navigation@1"
        },
        {
          "command": "vscode-hdl-dev.openArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.schematicJson",
          "group": "navigation@1"
        },
        {
          "command": "vscode-hdl-dev.openArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.log",
          "group": "navigation@1"
        },
        {
          "command": "vscode-hdl-dev.openArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.plot",
          "group": "navigation@1"
        },
        {
          "command": "vscode-hdl-dev.openArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.csv",
          "group": "navigation@1"
        },
        {
          "command": "vscode-hdl-dev.revealArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.waveDump",
          "group": "navigation@2"
        },
        {
          "command": "vscode-hdl-dev.revealArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.waveformSvg",
          "group": "navigation@2"
        },
        {
          "command": "vscode-hdl-dev.revealArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.schematicSvg",
          "group": "navigation@2"
        },
        {
          "command": "vscode-hdl-dev.revealArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.schematicJson",
          "group": "navigation@2"
        },
        {
          "command": "vscode-hdl-dev.revealArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.log",
          "group": "navigation@2"
        },
        {
          "command": "vscode-hdl-dev.revealArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.plot",
          "group": "navigation@2"
        },
        {
          "command": "vscode-hdl-dev.revealArtifact",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.csv",
          "group": "navigation@2"
        },
        {
          "command": "vscode-hdl-dev.copyArtifactPath",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.waveDump",
          "group": "navigation@3"
        },
        {
          "command": "vscode-hdl-dev.copyArtifactPath",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.waveformSvg",
          "group": "navigation@3"
        },
        {
          "command": "vscode-hdl-dev.copyArtifactPath",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.schematicSvg",
          "group": "navigation@3"
        },
        {
          "command": "vscode-hdl-dev.copyArtifactPath",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.schematicJson",
          "group": "navigation@3"
        },
        {
          "command": "vscode-hdl-dev.copyArtifactPath",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.log",
          "group": "navigation@3"
        },
        {
          "command": "vscode-hdl-dev.copyArtifactPath",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.plot",
          "group": "navigation@3"
        },
        {
          "command": "vscode-hdl-dev.copyArtifactPath",
          "when": "view == vscode-hdl-dev.artifacts && viewItem == hdlDev.artifacts.artifact.csv",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.116.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
